# Copy this file to .env for local development. Real values only ever live
# here locally and in the Vercel/Netlify project's environment variable
# settings -- never commit a filled-in .env.

# MongoDB connection string used to store waitlist signups.
# Example local: mongodb://127.0.0.1:27017/slang
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/slang?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=slang

# HMAC signing key for the waitlist's anti-abuse submit tokens. Required (32+
# chars) in production -- generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAITLIST_SECRET=

# Gmail SMTP (checked first). Enable 2-Step Verification on the Google
# Account, then generate a 16-character App Password at
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Slang <you@example.com>

# Generic SMTP fallback (used only if GMAIL_USER/GMAIL_APP_PASSWORD are unset).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Resend fallback (used only if no SMTP transport is configured above).
RESEND_API_KEY=
RESEND_FROM=Slang <onboarding@resend.dev>

# Comma-separated allowed origins for the waitlist submit check. Leave empty
# for same-origin (the normal case once this runs as part of slang-intro
# itself rather than a separately hosted page).
# ALLOWED_ORIGINS=

# Optional anti-abuse tuning -- sane defaults apply if left unset.
# POW_DIFFICULTY=4
# MIN_DWELL_MS=1800
# MAX_TOKEN_AGE_MS=2700000
# VERIFY_MX=false
